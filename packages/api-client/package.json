{
  "name": "@yupay/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./realtime": "./src/realtime/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "gen:api": "openapi-ts -i ../../docs/api/openapi.json -o src/generated -c @hey-api/client-fetch || echo 'openapi.json not yet generated'"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.5.0",
    "@tanstack/react-query": "^5.59.20",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.61.0",
    "@types/react": "^19.0.0",
    "@yupay/config-eslint": "workspace:*",
    "@yupay/config-tsconfig": "workspace:*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
