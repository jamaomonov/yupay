# Caddy — production config: the YuPay stack's internal host-router.
#
# Domain plan for yupay.uz:
#   yupay.uz, www.yupay.uz  → web (Next.js public storefront)
#   app.yupay.uz            → miniapp (Telegram Mini App)
#   admin.yupay.uz          → admin SPA (Vite static)
#   api.yupay.uz            → FastAPI + WebSocket
#   grafana.yupay.uz        → Grafana, gated by basic-auth
#
# This Caddy does NOT face the internet and does NOT own :80/:443 — the VPS is
# shared with a second stack (streamers-parser) and only one process can bind
# those ports, so a standalone edge proxy (infra/edge/) holds them, terminates
# TLS with Let's Encrypt, and forwards cleartext HTTP here over the ``yupay-edge``
# network. See ADR-0030.
#
# Consequences of sitting behind that edge:
#   * Every site address is written ``http://…``. This is load-bearing: a bare
#     ``yupay.uz`` is an HTTPS site to Caddy, so it binds :443 and never answers
#     the edge's cleartext forward on :80. ``auto_https off`` does NOT change
#     that — it only suppresses certificates and redirects, not the port.
#   * ``auto_https off`` — certificates are the edge's job. Without this Caddy
#     would try to solve ACME challenges on ports it cannot bind.
#   * ``trusted_proxies`` — the edge is the only hop in front of us, so its
#     X-Forwarded-{For,Proto,Host} must be preserved rather than overwritten.
#     Otherwise every request reaches FastAPI as plain http from the proxy's own
#     IP, which breaks scheme-aware URL building and IP-based rate limiting.
#
# DNS prerequisite: A records for the apex + each subdomain point at the VPS.

{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

# ---------- public storefront ----------
http://yupay.uz, http://www.yupay.uz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "interest-cohort=()"
		# ``script-src 'unsafe-inline'`` is forced by Next.js SSG: prerendered
		# pages bake inline bootstrap scripts into static HTML, so per-request
		# nonces are impossible and Next emits no hash manifest. Every other
		# resource class is locked down so an injected payload can't load
		# plugins, retarget <base>, post forms elsewhere, or exfiltrate to an
		# arbitrary origin. Telegram hosts serve the Login Widget (script +
		# oauth iframe).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org https://*.telegram.org; style-src 'self' 'unsafe-inline' https://telegram.org https://*.telegram.org; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.yupay.uz wss://api.yupay.uz; frame-src https://telegram.org https://*.telegram.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
	# Force the canonical apex so SEO does not split between yupay.uz / www.
	@redirectWww host www.yupay.uz
	redir @redirectWww https://yupay.uz{uri} permanent
	reverse_proxy web:3000
}

# ---------- Telegram Mini App ----------
http://app.yupay.uz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		# Telegram WebApp must be embeddable in the official client — do
		# NOT add X-Frame-Options: DENY here. CSP frame-ancestors handles
		# the policy for the storefront.
		Content-Security-Policy "frame-ancestors https://web.telegram.org https://*.telegram.org;"
	}
	reverse_proxy miniapp:80
}

# ---------- internal admin SPA ----------
http://admin.yupay.uz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	# admin is a static Vite build served by an nginx container.
	reverse_proxy admin:80
}

# ---------- API + websockets ----------
http://api.yupay.uz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# CORS is handled by FastAPI's ``CORSMiddleware`` (see
		# ``cors_allow_origins`` in api.env). Doing it here too made the
		# browser see two ``Access-Control-Allow-Origin`` values in the
		# response and reject the request.
	}

	# Prometheus scrapes api:8000 over the internal docker network; the
	# public hostname must not leak request-rate/latency internals.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# Payme's Merchant API (JSON-RPC) accepts calls only from Payme's
	# documented source range 185.234.113.1-185.234.113.15 (the /28 CIDR
	# below covers .0-.15). This is defense-in-depth alongside the
	# app-layer Basic Auth check (-32504 in yupay.modules.payme.routes) —
	# it does not replace it.
	#
	# yupay-caddy never sees Payme's real socket peer: the shared edge
	# proxy (infra/edge/Caddyfile) sits in front of every YuPay hostname
	# and forwards here over the ``yupay-edge`` network. That edge is NOT
	# Cloudflare for YuPay — "Clients reach these hostnames directly" per
	# infra/edge/Caddyfile — and it overwrites X-Forwarded-For with the
	# real peer address before forwarding. Combined with the
	# ``trusted_proxies static private_ranges`` global option above,
	# ``client_ip`` resolves to that real address; ``remote_ip`` would only
	# ever see the edge container's own private IP and would 403 every
	# genuine Payme call. Use ``client_ip`` (Caddy >= 2.7), not
	# ``remote_ip``, for this allowlist.
	@paymeMerchantBlocked {
		path /api/v1/payments/payme/merchant
		not client_ip 185.234.113.0/28
	}
	respond @paymeMerchantBlocked 403

	# Uzum Bank Merchant API webhook allowlist — DEFERRED, NOT ACTIVE.
	# Unlike Payme, Uzum has not yet documented their webhook source IPs.
	# Design spec §16 gap #6: "Uzum's webhook source IPs for a Caddy
	# allowlist (added later, like Payme; app-layer 10001 auth is the
	# real gate meanwhile)." Until Uzum confirms a range, the app-layer
	# Basic Auth check (errorCode 10001 in yupay.modules.uzum.routes) is
	# the only gate on this path — that check is sufficient on its own.
	#
	# Do NOT uncomment this with a guessed CIDR: a wrong range would
	# 403 genuine Uzum callbacks, and an active matcher left with an
	# empty/placeholder client_ip list would 403 all traffic on this
	# path. Once Uzum confirms their source IPs, fill in <UZUM_IPS>,
	# uncomment, and validate with `caddy validate` before reloading.
	#
	# @uzumMerchantBlocked {
	# 	path /api/v1/payments/uzum/*
	# 	not client_ip <UZUM_IPS>
	# }
	# respond @uzumMerchantBlocked 403

	# WebSocket upgrade has to come first — Caddy stops on the first
	# matching reverse_proxy directive.
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @websocket api:8000

	# Rate limiting lives inside FastAPI (slowapi). Caddy's
	# ``rate_limit`` directive ships in a community module that needs
	# a custom build; not worth dragging in a non-stock image just
	# for an outer circuit breaker. If volumetric abuse becomes a
	# real problem, swap to ``caddy/forward-auth`` or front Caddy
	# with Cloudflare's rate-limit rules.

	reverse_proxy api:8000
}

# ---------- Grafana (operators only) ----------
http://grafana.yupay.uz {
	encode zstd gzip
	# basic_auth gates the surface even before Grafana's own login —
	# anyone scanning subdomains for /login pages gets an instant 401
	# instead. The hash is generated with ``caddy hash-password`` and
	# injected through GRAFANA_BASIC_AUTH_HASH in the env file.
	basic_auth {
		ops {$GRAFANA_BASIC_AUTH_HASH}
	}
	reverse_proxy grafana:3000
}
