# Caddy — production config. Domains are placeholders; replace before first deploy.
{
	email ops@yupay.io
}

yupay.io, www.yupay.io {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "interest-cohort=()"
	}
	@redirectWww host www.yupay.io
	redir @redirectWww https://yupay.io{uri} permanent
	reverse_proxy web:3000
}

app.yupay.io {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
	}
	reverse_proxy miniapp:3000
}

api.yupay.io {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Access-Control-Allow-Origin "https://yupay.io https://app.yupay.io"
	}

	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @websocket api:8000

	rate_limit {
		zone api 100r/s
	}

	reverse_proxy api:8000
}

grafana.yupay.io {
	@allowed {
		# Replace with the office / VPN egress CIDRs before going live.
		remote_ip 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @allowed {
		reverse_proxy grafana:3000
	}
	respond 403
}
