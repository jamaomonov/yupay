# Caddy — production config: the YuPay stack's internal host-router.
#
# Domain plan for yupay.uz:
#   yupay.uz, www.yupay.uz  → web (Next.js public storefront)
#   app.yupay.uz            → miniapp (Telegram Mini App)
#   admin.yupay.uz          → admin SPA (Vite static)
#   partners.yupay.uz       → partners (Next.js affiliate site)
#   reseller.yupay.uz       → merchant (Next.js B2B reseller cabinet)
#   api.yupay.uz            → FastAPI + WebSocket
#   grafana.yupay.uz        → Grafana, gated by basic-auth
#
# This Caddy does NOT face the internet and does NOT own :80/:443 — the VPS is
# shared with a second stack (streamers-parser) and only one process can bind
# those ports, so a standalone edge proxy (infra/edge/) holds them, terminates
# TLS with Let's Encrypt, and forwards cleartext HTTP here over the ``yupay-edge``
# network. See ADR-0030.
#
# Consequences of sitting behind that edge:
#   * Every site address is written ``http://…``. This is load-bearing: a bare
#     ``yupay.uz`` is an HTTPS site to Caddy, so it binds :443 and never answers
#     the edge's cleartext forward on :80. ``auto_https off`` does NOT change
#     that — it only suppresses certificates and redirects, not the port.
#   * ``auto_https off`` — certificates are the edge's job. Without this Caddy
#     would try to solve ACME challenges on ports it cannot bind.
#   * ``trusted_proxies`` — the edge is the only hop in front of us, so its
#     X-Forwarded-{For,Proto,Host} must be preserved rather than overwritten.
#     Otherwise every request reaches FastAPI as plain http from the proxy's own
#     IP, which breaks scheme-aware URL building and IP-based rate limiting.
#
# DNS prerequisite: A records for the apex + each subdomain point at the VPS.

{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

# ---------- public storefront ----------
http://yupay.uz, http://www.yupay.uz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "interest-cohort=()"
		# ``script-src 'unsafe-inline'`` is forced by Next.js SSG: prerendered
		# pages bake inline bootstrap scripts into static HTML, so per-request
		# nonces are impossible and Next emits no hash manifest. Kept by an
		# explicit decision (docs/decisions/0043-storefront-csp-unsafe-inline.md):
		# no XSS sink exists, the token was moved out of localStorage, and a
		# nonce would force dynamic rendering and regress SEO. Every other
		# resource class is locked down so an injected payload can't load
		# plugins, retarget <base>, post forms elsewhere, or exfiltrate to an
		# arbitrary origin. Telegram hosts serve the Login Widget (script +
		# oauth iframe). mc.yandex.ru is Yandex.Metrika: tag.js (script-src),
		# hits + webvisor uploads over https AND webvisor's realtime WebSocket
		# (connect-src needs both the https:// and wss:// origins — a https
		# source does not cover the ws scheme), and webvisor's frame
		# (frame-src); its tracking pixels ride the existing ``img-src https:``.
		# Google tag / GA4 was removed from the storefront, so
		# googletagmanager.com and the google-analytics.com origins came out of
		# here with it: a standing permission for a script we no longer load is
		# an injection target we gain nothing by keeping.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org https://*.telegram.org https://mc.yandex.ru https://accounts.google.com; style-src 'self' 'unsafe-inline' https://telegram.org https://*.telegram.org https://accounts.google.com; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.yupay.uz wss://api.yupay.uz https://mc.yandex.ru wss://mc.yandex.ru https://accounts.google.com; frame-src https://telegram.org https://*.telegram.org https://mc.yandex.ru https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
	# Force the canonical apex so SEO does not split between yupay.uz / www.
	@redirectWww host www.yupay.uz
	redir @redirectWww https://yupay.uz{uri} permanent
	# Access log. There was none — Caddy 2 logs no request lines by default —
	# so the edge produced six lines in twenty-four hours and there was no way
	# to see which URLs traffic actually hit, spot a bot flood, or tell "the
	# origin is erroring" apart from "Cloudflare is". Going into a paid
	# campaign blind to that is the thing you regret on day one.
	#
	# To stdout, because promtail already ships container output to Loki; the
	# container's json-file driver caps it at 10MB x 3.
	#
	# The header filter is load-bearing, not tidiness: Caddy's JSON log
	# redacts ``Authorization`` and nothing else, so the merchant API's
	# signed-request credentials were being written verbatim to a log that
	# promtail ships to Loki — a logged secret (AGENTS §9), replayable for
	# the signature's 300s window by anyone with read access. Verified
	# against ``caddy:2-alpine`` before and after this block existed.
	#
	# Editing this file on prod needs ``up -d --force-recreate caddy``:
	# it is a single-file bind mount, and ``git checkout`` swaps the inode
	# out from under a running ``caddy reload``, which then re-reads the
	# stale one.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Merchant-Signature delete
				request>headers>X-Merchant-Key delete
			}
		}
	}
	# Hold and retry across a restart instead of answering 502.
	#
	# Deploys are stop-then-start, not rolling: `docker compose up -d` recreates
	# every service whose image changed, and Caddy answers 502 for the whole gap
	# — measured at roughly 5-15 seconds per deploy, which lands on customers
	# rather than on CI (the workflow's own health poll tolerates 120s and never
	# sees it). With one upstream, `lb_try_duration` turns that outage into
	# elevated latency: Caddy keeps the connection and retries until the new
	# container answers.
	#
	# Not a substitute for a rolling deploy, which is the real fix — but it is
	# three lines and it removes the customer-visible half of the problem.
	reverse_proxy web:3000 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# ---------- Telegram Mini App ----------
http://app.yupay.uz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		# Telegram WebApp must be embeddable in the official client — do
		# NOT add X-Frame-Options: DENY here. CSP frame-ancestors handles
		# the policy for the storefront.
		Content-Security-Policy "frame-ancestors https://web.telegram.org https://*.telegram.org;"
	}
	# This block had no access log until 2026-09-14, and the gap was found the
	# hard way: a user reported «Не удалось загрузить YuPay» and there was
	# nothing on the server to look at. The storefront and the API log; the one
	# surface people open from inside Telegram did not, so every failed load was
	# invisible — no status, no duration, no user agent. A page that fails for
	# only some networks is exactly the case that cannot be diagnosed without
	# this.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Merchant-Signature delete
				request>headers>X-Merchant-Key delete
			}
		}
	}
	reverse_proxy miniapp:80 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# ---------- affiliate partner site ----------
http://partners.yupay.uz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		# Nothing here is meant to be embedded. The panel holds a partner's
		# balance and a payout form, which is exactly what a clickjacking
		# frame would want.
		X-Frame-Options "DENY"
	}
	reverse_proxy partners:3003 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# ---------- B2B reseller cabinet ----------
# A different product from partners.yupay.uz despite the adjacent name: that
# one is the affiliate programme, this one is where a reseller signs in, reads
# the wholesale price list and holds their API keys. Its own origin, because
# the cabinet keeps a session token in `localStorage` and an origin is the
# only boundary that isolates one.
http://reseller.yupay.uz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		# The one moment an API secret is readable is a panel on this origin.
		X-Frame-Options "DENY"
	}
	reverse_proxy merchant:3004 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# ---------- internal admin SPA ----------
http://admin.yupay.uz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	# admin is a static Vite build served by an nginx container.
	reverse_proxy admin:80 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# ---------- API + websockets ----------
http://api.yupay.uz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# CORS is handled by FastAPI's ``CORSMiddleware`` (see
		# ``cors_allow_origins`` in api.env). Doing it here too made the
		# browser see two ``Access-Control-Allow-Origin`` values in the
		# response and reject the request.
	}

	# Prometheus scrapes api:8000 over the internal docker network; the
	# public hostname must not leak request-rate/latency internals.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# Payme's Merchant API (JSON-RPC) accepts calls only from Payme's
	# documented source range 185.234.113.1-185.234.113.15 (the /28 CIDR
	# below covers .0-.15). This is defense-in-depth alongside the
	# app-layer Basic Auth check (-32504 in yupay.modules.payme.routes) —
	# it does not replace it.
	#
	# yupay-caddy never sees Payme's real socket peer: the shared edge
	# proxy (infra/edge/Caddyfile) sits in front of every YuPay hostname
	# and forwards here over the ``yupay-edge`` network, overwriting
	# X-Forwarded-For with the real client before it does. Combined with
	# the ``trusted_proxies static private_ranges`` global option above,
	# ``client_ip`` resolves to that real address; ``remote_ip`` would only
	# ever see the edge container's own private IP and would 403 every
	# genuine Payme call. Use ``client_ip`` (Caddy >= 2.7), not
	# ``remote_ip``, for this allowlist.
	#
	# Since 2026-08-15 these hostnames are proxied by Cloudflare, so the
	# edge derives that value from CF-Connecting-IP when the peer is a
	# Cloudflare range and from the peer itself otherwise — see the two
	# handles there. This matcher is the canary for that wiring: if the
	# edge ever hands us a Cloudflare address instead of the client, every
	# genuine Payme webhook 403s here and payments stop.
	@paymeMerchantBlocked {
		path /api/v1/payments/payme/merchant
		not client_ip 185.234.113.0/28
	}
	respond @paymeMerchantBlocked 403

	# Uzum Bank Merchant API webhook allowlist — DEFERRED, NOT ACTIVE.
	# Unlike Payme, Uzum has not yet documented their webhook source IPs.
	# Design spec §16 gap #6: "Uzum's webhook source IPs for a Caddy
	# allowlist (added later, like Payme; app-layer 10001 auth is the
	# real gate meanwhile)." Until Uzum confirms a range, the app-layer
	# Basic Auth check (errorCode 10001 in yupay.modules.uzum.routes) is
	# the only gate on this path — that check is sufficient on its own.
	#
	# Do NOT uncomment this with a guessed CIDR: a wrong range would
	# 403 genuine Uzum callbacks, and an active matcher left with an
	# empty/placeholder client_ip list would 403 all traffic on this
	# path. Once Uzum confirms their source IPs, fill in <UZUM_IPS>,
	# uncomment, and validate with `caddy validate` before reloading.
	#
	# @uzumMerchantBlocked {
	# 	path /api/v1/payments/uzum/*
	# 	not client_ip <UZUM_IPS>
	# }
	# respond @uzumMerchantBlocked 403

	# Paynet's UWS endpoint. Their seven source addresses, given by
	# Дильшод on 2026-09-22 in answer to our certification questions —
	# individual hosts, not a range, so each carries an implicit /32.
	# Defense-in-depth alongside the HTTP Basic check in
	# ``yupay.modules.paynet.routes``, which stays the real gate: unlike
	# Payme's ``-32504``, a failure there is a bare HTTP 401.
	#
	# Same ``client_ip``-not-``remote_ip`` reasoning as the Payme matcher
	# above — read that comment before touching this one.
	#
	# 195.158.21.42 is their **test** address. It is listed here rather
	# than left out so certification can run against production, and it
	# should come out once Paynet has signed the integration off. Removing
	# it is a Caddyfile edit plus ``up -d --force-recreate caddy`` — a
	# plain ``reload`` re-reads the stale inode behind the bind mount.
	#
	# Safe to switch on now: ``PAYNET_PAY_URL_TEMPLATE`` is unset on prod,
	# so the gateway reports ``available=False`` and no customer is sent
	# to Paynet yet. There is no live traffic here for a wrong address to
	# break — which is exactly why it goes in before go-live, not after.
	@paynetUwsBlocked {
		path /api/v1/payments/paynet/uws
		not client_ip 109.207.244.62 62.209.139.94 109.207.244.94 89.236.220.222 91.196.76.52 94.158.63.240 195.158.21.42
	}
	respond @paynetUwsBlocked 403

	# WebSocket upgrade has to come first — Caddy stops on the first
	# matching reverse_proxy directive.
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @websocket api:8000

	# Rate limiting lives inside FastAPI (slowapi). Caddy's
	# ``rate_limit`` directive ships in a community module that needs
	# a custom build; not worth dragging in a non-stock image just
	# for an outer circuit breaker. If volumetric abuse becomes a
	# real problem, swap to ``caddy/forward-auth`` or front Caddy
	# with Cloudflare's rate-limit rules.

	# Access log. There was none — Caddy 2 logs no request lines by default —
	# so the edge produced six lines in twenty-four hours and there was no way
	# to see which URLs traffic actually hit, spot a bot flood, or tell "the
	# origin is erroring" apart from "Cloudflare is". Going into a paid
	# campaign blind to that is the thing you regret on day one.
	#
	# To stdout, because promtail already ships container output to Loki; the
	# container's json-file driver caps it at 10MB x 3.
	#
	# The header filter is load-bearing, not tidiness: Caddy's JSON log
	# redacts ``Authorization`` and nothing else, so the merchant API's
	# signed-request credentials were being written verbatim to a log that
	# promtail ships to Loki — a logged secret (AGENTS §9), replayable for
	# the signature's 300s window by anyone with read access. Verified
	# against ``caddy:2-alpine`` before and after this block existed.
	#
	# Editing this file on prod needs ``up -d --force-recreate caddy``:
	# it is a single-file bind mount, and ``git checkout`` swaps the inode
	# out from under a running ``caddy reload``, which then re-reads the
	# stale one.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Merchant-Signature delete
				request>headers>X-Merchant-Key delete
			}
		}
	}
	reverse_proxy api:8000 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# ---------- Grafana (operators only) ----------
http://grafana.yupay.uz {
	encode zstd gzip
	# basic_auth gates the surface even before Grafana's own login —
	# anyone scanning subdomains for /login pages gets an instant 401
	# instead. The hash is generated with ``caddy hash-password`` and
	# injected through GRAFANA_BASIC_AUTH_HASH in the env file.
	basic_auth {
		ops {$GRAFANA_BASIC_AUTH_HASH}
	}
	reverse_proxy grafana:3000
}
