# Grafana admin user is also gated by Caddy basic-auth on
# grafana.yupay.uz — two layers, both passwords should be strong.

GF_SECURITY_ADMIN_USER=ops
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_strong_password
GF_SERVER_ROOT_URL=https://grafana.yupay.uz
GF_USERS_ALLOW_SIGN_UP=false

# Caddy reads this via the {$GRAFANA_BASIC_AUTH_HASH} placeholder in
# Caddyfile.prod. Generate with:
#   docker compose -f docker-compose.prod.yml run --rm --no-deps caddy \
#     caddy hash-password --plaintext "the-real-password"
GRAFANA_BASIC_AUTH_HASH=CHANGE_ME_bcrypt_hash_from_caddy_hash-password
