# Runtime config for api / worker / scheduler / bot.
# Compose mounts the same file into all four — they share the same Postgres,
# Redis, JWT keys, Telegram credentials.

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://yupay_app:CHANGE_ME_match_postgres_env@postgres:5432/yupay

# ----- Redis -----
# Password must match REDIS_PASSWORD in redis.env (requirepass).
REDIS_URL=redis://:CHANGE_ME_match_redis_env@redis:6379/0
DRAMATIQ_BROKER_URL=redis://:CHANGE_ME_match_redis_env@redis:6379/1

# ----- Public URLs -----
BASE_URL=https://api.yupay.uz
CORS_ALLOW_ORIGINS=["https://yupay.uz","https://app.yupay.uz","https://admin.yupay.uz"]

# ----- JWT (Ed25519, base64-encoded PEM) -----
# See infra/secrets-example/README.md "JWT keypair" for generation.
JWT_PUBLIC_KEY=CHANGE_ME_base64_pem
JWT_PRIVATE_KEY=CHANGE_ME_base64_pem
JWT_ISSUER=yupay
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ----- Auth: email links + IP guard -----
JWT_EMAIL_TOKEN_TTL_SECONDS=1800
AUTH_IP_GUARD_MAX=10
AUTH_IP_GUARD_WINDOW_SECONDS=60
# Public web base used to build email links (no trailing slash).
WEB_BASE_URL=https://yupay.uz

# ----- Email: Resend (resend.com) -----
# API key for transactional email (verify/reset + guest order emails). Empty =>
# send_email raises EmailSendError and sends are skipped (best-effort). The
# sending domain must have DKIM/SPF/DMARC configured in Resend.
RESEND_API_KEY=CHANGE_ME_or_leave_empty
EMAIL_FROM=noreply@yupay.uz
EMAIL_FROM_NAME=YuPay
# Public PNG logo shown in email headers (email clients don't render SVG).
# Empty => falls back to {WEB_BASE_URL}/logo/email-logo.png, then a text wordmark.
EMAIL_LOGO_URL=

# ----- Telegram -----
# Token from @BotFather. Username is what you set with /setname.
TELEGRAM_BOT_TOKEN=CHANGE_ME_from_botfather
TELEGRAM_BOT_USERNAME=yupay_bot
TELEGRAM_MINIAPP_URL=https://app.yupay.uz
# Dedicated bot for the admin panel Login Widget. Create a second bot in
# @BotFather, run /setdomain => admin.yupay.uz, and paste its token here. Empty
# => admin login verifies against the customer bot token above (single-bot mode).
ADMIN_TELEGRAM_BOT_TOKEN=CHANGE_ME_or_leave_empty
# Outbound proxy for api.telegram.org when the host can't reach Telegram directly
# (e.g. hosted in RU). HTTP proxy: http://user:pass@host:port. Empty => direct.
TELEGRAM_PROXY_URL=CHANGE_ME_or_leave_empty

# ----- FX -----
# Free key from https://www.exchangerate-api.com (1500 req/mo).
FX_EXCHANGERATE_API_KEY=CHANGE_ME_or_leave_empty
# Kill-switch: a drop bigger than this (UZS/RUB) puts active payment
# providers — including wallet — into maintenance and pages the ops chat.
FX_DROP_TRIPWIRE_PCT=6
FX_REFRESH_INTERVAL_MINUTES=5

# ----- Integrations: G2Bulk (G2B) -----
# API key obtained via the G2Bulk Telegram bot. Empty key => adapter reports
# ``available=False`` and the admin /integrations page shows "not configured".
G2B_API_KEY=CHANGE_ME_or_leave_empty
G2B_BASE_URL=https://api.g2bulk.com/v1
# Random 32+ char token; embedded into the public webhook URL path.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
G2B_WEBHOOK_SECRET=CHANGE_ME_random_32_chars
# Full callback URL we pass when creating game orders. Leave empty if G2B
# cannot reach the API publicly — the polling actor handles updates instead.
G2B_CALLBACK_URL=https://api.yupay.uz/api/v1/webhooks/g2b/CHANGE_ME_match_webhook_secret
G2B_REQUEST_TIMEOUT_SECONDS=20

# ----- Integrations: Waxpeer (Steam wallet top-ups) -----
# API key from https://waxpeer.com/profile/user. Empty key => the waxpeer
# adapter reports ``available=False`` and Steam top-ups can't be sold.
WAXPEER_API_KEY=CHANGE_ME_or_leave_empty
WAXPEER_BASE_URL=https://api.waxpeer.com/v1
WAXPEER_REQUEST_TIMEOUT_SECONDS=20
# Waxpeer's cut of a top-up, as a fraction in [0, 1). 0 today; if a
# ``waxpeer.give_amount_short`` alert fires, a fee appeared — set it here so we
# gross the amount up and the customer still receives what they asked for.
WAXPEER_FEE_RATE=0

# ----- Acquirer: Octo (octo.uz) -----
# Card acquirer for the UZ market (Uzcard/Humo/Visa). Empty shop_id/secret =>
# gateway reports available=False and disappears from /payments/providers
# (the miniapp "Карта" method auto-disables). octo_pay_url is hosted by Octo.
OCTO_SHOP_ID=CHANGE_ME_or_leave_empty
OCTO_SECRET=CHANGE_ME_octo_merchant_secret
# Webhook signature key (Octo's "unique_key"), issued separately by Octo tech
# support. Used to verify SHA1(unique_key + octo_payment_UUID + status). In prod
# an empty value means inbound webhooks are REJECTED — never trust an unsigned callback.
OCTO_SIGNATURE_KEY=CHANGE_ME_octo_unique_key
OCTO_BASE_URL=https://secure.octo.uz
# Send test transactions (no real charge). Set true in dev, false in prod.
OCTO_TEST_MODE=false
OCTO_REQUEST_TIMEOUT_SECONDS=20
# Octo POSTs callbacks to {BASE_URL}/api/v1/webhooks/payments/octo — make sure
# BASE_URL above is publicly reachable (a tunnel in dev).

# ----- Acquirer: Payme (Paycom Merchant API) -----
# Hosted-checkout acquirer for the UZ market. Empty PAYME_MERCHANT_ID => gateway
# reports available=False and disappears from /payments/providers. The Merchant
# API endpoint accepts either the sandbox key or the production key — set
# whichever matches PAYME_CHECKOUT_URL below.
#
# Sandbox (testing): fill PAYME_MERCHANT_ID + PAYME_TEST_KEY and set
#   PAYME_CHECKOUT_URL=https://test.paycom.uz
# Go-live: additionally fill PAYME_KEY (the production/cabinet key) and set
#   PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_MERCHANT_ID=CHANGE_ME_or_leave_empty
PAYME_KEY=CHANGE_ME_production_key_or_leave_empty
PAYME_TEST_KEY=CHANGE_ME_sandbox_key_or_leave_empty
PAYME_LOGIN=Paycom
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# ----- Acquirer: Uzum (Merchant API) -----
# Hosted-checkout acquirer for the UZ market. Empty UZUM_SERVICE_ID => gateway
# reports available=False and disappears from /payments/providers. The
# Merchant API endpoint accepts either the sandbox credentials or the
# production credentials — set whichever matches your current cabinet.
#
# Sandbox (testing): fill UZUM_SERVICE_ID + UZUM_TEST_LOGIN + UZUM_TEST_PASSWORD.
# Go-live: additionally fill UZUM_LOGIN + UZUM_PASSWORD (the production/cabinet
#   credentials).
# UZUM_SERVICE_ID is an integer (your Uzum cabinet's numeric service id).
# Leave it empty to disable the gateway (available=False) — do not put
# placeholder text here, it must be blank or a real integer.
UZUM_SERVICE_ID=
UZUM_LOGIN=CHANGE_ME_production_login_or_leave_empty
UZUM_PASSWORD=CHANGE_ME_production_password_or_leave_empty
UZUM_TEST_LOGIN=CHANGE_ME_sandbox_login_or_leave_empty
UZUM_TEST_PASSWORD=CHANGE_ME_sandbox_password_or_leave_empty
UZUM_OPEN_SERVICE_URL=https://www.uzumbank.uz/open-service

# ----- Acquirer: Click (Shop API — Prepare/Complete) -----
# Two Click services share one merchant: web (yupay.uz) and bot (Telegram mini
# app). Empty CLICK_MERCHANT_ID => gateway reports available=False. Click signs
# every Prepare/Complete webhook with an MD5 sign_string keyed on the
# per-service SECRET_KEY, so the secret for the service_id in each request must
# be set. ``amount`` is in soums (major units), not tiyin.
# The numeric ids (merchant/service/merchant-user) must be blank or a real
# integer — never placeholder text (it would crash Settings at startup).
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID_WEB=
CLICK_SERVICE_ID_BOT=
CLICK_SECRET_KEY_WEB=CHANGE_ME_click_web_secret_or_leave_empty
CLICK_SECRET_KEY_BOT=CHANGE_ME_click_bot_secret_or_leave_empty
CLICK_MERCHANT_USER_ID_WEB=
CLICK_MERCHANT_USER_ID_BOT=
CLICK_PAY_URL=https://my.click.uz/services/pay

# ----- Admin alert bot (separate Telegram bot for ops notifications) -----
# Get a fresh bot from @BotFather, do NOT reuse the customer bot token.
# CHAT_ID is the destination chat — usually a private channel with the
# ops team; obtain via @userinfobot or @RawDataBot.
TG_ALERT_BOT_TOKEN=CHANGE_ME_from_botfather_separate_admin_bot
TG_ALERT_CHAT_ID=CHANGE_ME_chat_id_of_ops_channel

# Trigger an alert when a supplier's price moves by ≥ this many %.
PRICE_ALERT_THRESHOLD_PCT=5
# How often the scheduler re-prices every active mapping.
PRICE_REFRESH_INTERVAL_MINUTES=60

# Warn ops when the supplier (G2B) USDT wallet drops below this many
# dollars. Set to 0 to disable the proactive heads-up alert. The
# per-order ``supplier_low_balance`` alert (fires when a real customer
# order is rejected) is independent and always on if the alert bot
# is configured.
SUPPLIER_LOW_BALANCE_THRESHOLD=50

# ----- Observability -----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
LOG_JSON=true

# ----- Media: Cloudflare R2 -----
# The ONLY storage the code reads (modules/storage/client.py builds a boto3
# client against ``https://<account>.r2.cloudflarestorage.com``). The admin SPA
# uploads images with a presigned PUT this API issues, so uploads never pass
# through FastAPI. Empty account/key => get_s3_client() raises at the first
# upload; everything else in the app keeps working.
#
# This block used to describe a MinIO container via S3_*. Those keys were read
# by nothing at all — the settings object has no S3_* fields — so a stack could
# come up "fully configured" with image upload broken. Do not reintroduce them.
R2_ACCOUNT_ID=CHANGE_ME_cloudflare_account_id
R2_ACCESS_KEY_ID=CHANGE_ME_r2_access_key
R2_SECRET_ACCESS_KEY=CHANGE_ME_r2_secret
R2_BUCKET_MEDIA=yupay-media
# Public read prefix, no trailing slash. Either an R2 custom domain
# (https://cdn.yupay.uz — needs the DNS record) or the bucket's r2.dev URL.
R2_PUBLIC_BASE_URL=https://cdn.yupay.uz

# ----- Guest-JWT email hashing -----
# Pepper mixed into the SHA-256 email hashes embedded in guest JWTs. Generate a
# fresh one per environment — never reuse the dev value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating it invalidates existing guest tokens.
AUTH_EMAIL_PEPPER=CHANGE_ME_random_32_chars
