# Runtime config for api / worker / scheduler / bot.
# Compose mounts the same file into all four — they share the same Postgres,
# Redis, JWT keys, Telegram credentials.

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://yupay_app:CHANGE_ME_match_postgres_env@postgres:5432/yupay

# ----- Redis -----
REDIS_URL=redis://redis:6379/0
DRAMATIQ_BROKER_URL=redis://redis:6379/1

# ----- Public URLs -----
BASE_URL=https://api.yupay.uz
CORS_ALLOW_ORIGINS=["https://yupay.uz","https://app.yupay.uz","https://admin.yupay.uz"]

# ----- JWT (Ed25519, base64-encoded PEM) -----
# See infra/secrets-example/README.md "JWT keypair" for generation.
JWT_PUBLIC_KEY=CHANGE_ME_base64_pem
JWT_PRIVATE_KEY=CHANGE_ME_base64_pem
JWT_ISSUER=yupay
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ----- Telegram -----
# Token from @BotFather. Username is what you set with /setname.
TELEGRAM_BOT_TOKEN=CHANGE_ME_from_botfather
TELEGRAM_BOT_USERNAME=yupay_bot
TELEGRAM_MINIAPP_URL=https://app.yupay.uz

# ----- FX -----
# Free key from https://www.exchangerate-api.com (1500 req/mo).
FX_EXCHANGERATE_API_KEY=CHANGE_ME_or_leave_empty

# ----- Integrations: G2Bulk (G2B) -----
# API key obtained via the G2Bulk Telegram bot. Empty key => adapter reports
# ``available=False`` and the admin /integrations page shows "not configured".
G2B_API_KEY=CHANGE_ME_or_leave_empty
G2B_BASE_URL=https://api.g2bulk.com/v1
# Random 32+ char token; embedded into the public webhook URL path.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
G2B_WEBHOOK_SECRET=CHANGE_ME_random_32_chars
# Full callback URL we pass when creating game orders. Leave empty if G2B
# cannot reach the API publicly — the polling actor handles updates instead.
G2B_CALLBACK_URL=https://api.yupay.uz/api/v1/webhooks/g2b/CHANGE_ME_match_webhook_secret
G2B_REQUEST_TIMEOUT_SECONDS=20

# ----- Admin alert bot (separate Telegram bot for ops notifications) -----
# Get a fresh bot from @BotFather, do NOT reuse the customer bot token.
# CHAT_ID is the destination chat — usually a private channel with the
# ops team; obtain via @userinfobot or @RawDataBot.
TG_ALERT_BOT_TOKEN=CHANGE_ME_from_botfather_separate_admin_bot
TG_ALERT_CHAT_ID=CHANGE_ME_chat_id_of_ops_channel

# Trigger an alert when a supplier's price moves by ≥ this many %.
PRICE_ALERT_THRESHOLD_PCT=5
# How often the scheduler re-prices every active mapping.
PRICE_REFRESH_INTERVAL_MINUTES=60

# Warn ops when the supplier (G2B) USDT wallet drops below this many
# dollars. Set to 0 to disable the proactive heads-up alert. The
# per-order ``supplier_low_balance`` alert (fires when a real customer
# order is rejected) is independent and always on if the alert bot
# is configured.
SUPPLIER_LOW_BALANCE_THRESHOLD=50

# ----- Observability -----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
LOG_JSON=true

# ----- MinIO (S3-compatible) -----
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=yupay
S3_SECRET_KEY=CHANGE_ME_match_minio_env
S3_BUCKET=yupay
S3_REGION=us-east-1
