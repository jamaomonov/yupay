# Public Next.js storefront. Only NEXT_PUBLIC_* — everything here is
# shipped to the browser in the JS bundle, so keep it strictly public.
NEXT_PUBLIC_API_BASE_URL=https://api.yupay.uz
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yupay.uz
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=yupay_bot
# Numeric bot id (token prefix before ":") for the login modal's custom Telegram
# button (OAuth popup). Empty => modal falls back to the official widget button.
# NOTE: NEXT_PUBLIC_* are inlined at `next build` (build.yml build-args), so this
# file is documentation — the build-arg is what actually reaches the bundle.
NEXT_PUBLIC_TELEGRAM_BOT_ID=
