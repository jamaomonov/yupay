# Nightly Postgres → age → rclone → R2 pipeline.
# See infra/backup/pg_backup.sh for the script.

PGHOST=postgres
PGPORT=5432
PGUSER=yupay_app
PGPASSWORD=CHANGE_ME_match_postgres_env
PGDATABASE=yupay

# Public AGE recipient (the corresponding private key stays OFFLINE
# on the operator's machine — losing it loses the backups).
# Generate: age-keygen -o ~/yupay-backup.key
BACKUP_AGE_RECIPIENT=CHANGE_ME_age1…

# Rclone remote configured via `rclone config` on the host.
# See README.md "rclone remote" for setup.
RCLONE_REMOTE=r2:yupay-backups
