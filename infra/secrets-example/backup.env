# Nightly Postgres → age → rclone → R2 pipeline.
# Driven by infra/backup/run_nightly.sh, which sleeps until BACKUP_HOUR_UTC and
# then runs infra/backup/pg_backup.sh.

PGHOST=postgres
PGPORT=5432
PGUSER=yupay_app
PGPASSWORD=CHANGE_ME_match_postgres_env
PGDATABASE=yupay

# Hour (UTC) the nightly run fires.
BACKUP_HOUR_UTC=2

# Public AGE recipient. The matching PRIVATE key stays OFFLINE on the operator's
# machine — a server able to decrypt its own backups defeats the point of
# encrypting them, so the secret key must never appear here. Lose that file and
# every backup is unreadable; there is no recovery path.
#   age-keygen -o ~/yupay-backup.key    # the "public key:" line goes below
BACKUP_AGE_RECIPIENT=CHANGE_ME_age1…

# --- rclone remote, defined entirely through env ---
# The backup container mounts no rclone.conf, so `rclone config` on the host does
# nothing for it — the remote has to come from these RCLONE_CONFIG_<REMOTE>_<KEY>
# variables. Without them rclone exits with "didn't find section in config file".
RCLONE_REMOTE=r2:yupay-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_REGION=auto
RCLONE_CONFIG_R2_ENDPOINT=https://CHANGE_ME_account_id.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=CHANGE_ME_r2_access_key
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=CHANGE_ME_r2_secret

# R2 API tokens are scoped to objects, not buckets. Before uploading, rclone
# otherwise probes (and may try to create) the bucket — which such a token is not
# allowed to do, so the upload dies with "failed to prepare upload: AccessDenied"
# even though writing the object itself is permitted. Skip the probe. Create the
# bucket in the Cloudflare dashboard, and make sure the token's scope covers it:
# a token issued for the media bucket alone returns 403 here.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
