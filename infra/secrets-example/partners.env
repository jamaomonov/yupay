# Public config for the partner site (partners.yupay.uz).
#
# Everything here is NEXT_PUBLIC_* and is inlined into the browser bundle at
# build time, so none of it is secret — it is in this file so an operator can
# see what the app expects in one place.
#
# The build-time values live in the CI build args (see partners.Dockerfile);
# these are the runtime equivalents for a container started from a prebuilt
# image, and they must match what the image was built with.

NEXT_PUBLIC_API_BASE_URL=https://api.yupay.uz
NEXT_PUBLIC_STOREFRONT_URL=https://yupay.uz
