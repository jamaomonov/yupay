{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Infra · Overview",
  "uid": "yupay-infra-overview",
  "schemaVersion": 39,
  "timezone": "",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["yupay", "infra"],
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Host CPU (%)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "cpu"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Host memory used (%)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "mem"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Disk used (root, %)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "id": 3,
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100",
          "legendFormat": "disk"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Load avg (1m)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "id": 4,
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "node_load1", "legendFormat": "load1" }],
      "options": { "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "decimals": 2 } }
    },
    {
      "type": "timeseries",
      "title": "Per-container memory (YuPay)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "id": 5,
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (name) (container_memory_usage_bytes{name=~\"yupay-prod-.*\"})",
          "legendFormat": "{{name}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "Per-container CPU % (YuPay)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "id": 6,
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"yupay-prod-.*\"}[2m])) * 100",
          "legendFormat": "{{name}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "type": "timeseries",
      "title": "Network I/O (host)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "id": 7,
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[1m])",
          "legendFormat": "rx {{device}}"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[1m])",
          "legendFormat": "tx {{device}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "type": "timeseries",
      "title": "Postgres connections by state (max 100)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "id": 8,
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sum by (state) (pg_stat_activity_count{state!=\"\"})",
          "legendFormat": "{{state}}"
        },
        { "expr": "max(pg_settings_max_connections)", "legendFormat": "max_connections" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last"] } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max_connections" },
            "properties": [
              { "id": "custom.drawStyle", "value": "line" },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Service uptime (scrape targets)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "id": 9,
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 6 },
      "targets": [{ "expr": "up", "format": "table", "instant": true }],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "service": true,
              "env": true
            },
            "renameByName": { "job": "Service", "Value": "Up?" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" } }, "type": "value" },
            { "options": { "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ],
          "custom": { "cellOptions": { "type": "color-background" }, "align": "left" }
        }
      }
    }
  ]
}
