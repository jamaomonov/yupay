{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Logs · Explorer",
  "uid": "yupay-logs-overview",
  "schemaVersion": 39,
  "timezone": "",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["yupay", "logs"],
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "loki" },
        "hide": 2
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": { "label": "container", "type": 1 },
        "definition": "label_values(container)",
        "regex": "/^yupay-prod-.*/",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "All : .*, error : error, warn : warn, info : info",
        "current": { "text": "All", "value": ".*" }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Error lines (range)",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(count_over_time({container=~\"$container\"} | detected_level=\"error\" [$__range]))",
          "legendFormat": "errors"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Warn lines (range)",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(count_over_time({container=~\"$container\"} | detected_level=\"warn\" [$__range]))",
          "legendFormat": "warns"
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "stat",
      "title": "Total lines / sec",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "id": 3,
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 4 },
      "targets": [
        { "expr": "sum(rate({container=~\"$container\"}[5m]))", "legendFormat": "lines/s" }
      ],
      "options": { "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 } }
    },
    {
      "type": "timeseries",
      "title": "Log volume by container",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "id": 4,
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (container) (rate({container=~\"$container\"}[$__auto]))",
          "legendFormat": "{{container}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Errors / warnings per minute",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "id": 5,
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (detected_level) (count_over_time({container=~\"$container\"} | detected_level=~\"error|warn\" [1m]))",
          "legendFormat": "{{detected_level}}"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 70 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warn" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      }
    },
    {
      "type": "logs",
      "title": "Log stream — $container / level=$level / search=\"$search\"",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "id": 6,
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 16 },
      "targets": [
        {
          "expr": "{container=~\"$container\"} | detected_level=~\"$level\" |= \"$search\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
