sequenceDiagram
    autonumber
    actor Buyer
    participant Web as Web / Mini App
    participant API as reviews.routes
    participant Svc as reviews.service
    participant DB as Postgres

    Buyer->>Web: Tap "Rate your purchase" (from order history)
    Web->>API: POST /reviews {order_id, brand_slug, rating, body} + Idempotency-Key
    API->>Svc: create_review(user_id, order_id, brand_slug, rating, body)
    Svc->>DB: resolve brand_id from slug
    Svc->>DB: load order (owner? delivered? contains brand?)
    alt not owner / not delivered / brand not in order
        Svc-->>API: ForbiddenError (403)
    else eligible
        Svc->>DB: INSERT review (published) [UNIQUE user+order+brand]
        alt already reviewed
            DB-->>Svc: IntegrityError
            Svc-->>API: ConflictError 409 already_reviewed
        else new
            Svc->>DB: SELECT brand_rating_stats FOR UPDATE
            Svc->>DB: bump count / sum / avg / histogram
            Svc-->>API: Review
            API-->>Web: 201 ReviewOut
        end
    end
