# YuPay — root .env.example
# Copy to .env (gitignored) and fill in values for your local stack.

# ----- Postgres -----
POSTGRES_USER=yupay_app
POSTGRES_PASSWORD=yupay_app
POSTGRES_DB=yupay
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_PORT=6379

# ----- MinIO -----
MINIO_ROOT_USER=yupay
MINIO_ROOT_PASSWORD=yupay-dev-secret-change-me
MINIO_PORT_API=9000
MINIO_PORT_CONSOLE=9001

# ----- App -----
ENVIRONMENT=dev
DEBUG=true
SERVICE_NAME=yupay-api
BASE_URL=http://localhost:8000

# Set inside compose to point at service names. These are overrides for host processes.
DATABASE_URL=postgresql+asyncpg://yupay_app:yupay_app@postgres:5432/yupay
REDIS_URL=redis://redis:6379/0

# ----- Auth -----
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_ISSUER=yupay
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# TTL for email-verify / password-reset links (seconds). Default 30 min.
JWT_EMAIL_TOKEN_TTL_SECONDS=1800
# Lightweight per-IP guard on POST /auth/login and /auth/password/forgot.
AUTH_IP_GUARD_MAX=10
# Attempts per window against ONE identity (ip + email) on the credential
# endpoints. This is the axis that blunts brute force, which is what lets the
# per-IP numbers be sized for a mobile-carrier NAT instead of for one attacker.
AUTH_IP_GUARD_SUBJECT_MAX=10
# Per-bucket per-IP overrides. Uzbek mobile carriers put many subscribers behind
# one address, so these are crowd-sized on purpose. Buckets not listed here keep
# AUTH_IP_GUARD_MAX. Values <= 0 are ignored, so a typo cannot disable the guard.
# AUTH_IP_GUARD_BUCKET_MAX={"check_player":200,"promo-redeem":120,"login":60}
AUTH_IP_GUARD_WINDOW_SECONDS=60
# Absolute public web base (no trailing slash) used to build links in emails,
# e.g. https://yupay.uz. Empty => falls back to the request's own host.
WEB_BASE_URL=

# ----- Email (Resend) -----
# Transactional email (verify/reset + guest order confirmation/delivery).
# Empty RESEND_API_KEY => send_email raises and sends are skipped (best-effort).
RESEND_API_KEY=
EMAIL_FROM=noreply@yupay.uz
EMAIL_FROM_NAME=YuPay
# Public PNG logo shown in email headers (clients don't render SVG). Empty =>
# falls back to {WEB_BASE_URL}/logo/email-logo.png, then to a text wordmark.
EMAIL_LOGO_URL=

# ----- Telegram -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Separate bot for the admin panel Login Widget (domain-bound to admin.yupay.uz
# via BotFather /setdomain). Empty => admin login falls back to the customer bot.
ADMIN_TELEGRAM_BOT_TOKEN=
# Outbound proxy for the Telegram Bot API (bot polling + notifications) when the
# host can't reach api.telegram.org directly (e.g. RU). HTTP proxy:
# http://user:pass@host:port. Empty => connect directly.
TELEGRAM_PROXY_URL=
# Public URL of the Telegram Mini App — used by the bot to wire the
# inline WebAppInfo button on /start. In dev with Caddy: leave as
# default; in prod set to https://app.yupay.uz.
TELEGRAM_MINIAPP_URL=https://yupay.local/miniapp/

# ----- FX -----
# Free tier: https://www.exchangerate-api.com — 1500 req/mo.
# When empty, the chain falls through to exchangerate.host (often flaky).
FX_EXCHANGERATE_API_KEY=
# https://fxratesapi.com — live key; empty skips this adapter.
FX_RATES_API_KEY=

# ----- Media: Cloudflare R2 -----
# The only storage the code reads (modules/storage/client.py). Uploads go
# straight from the admin SPA to R2 with a presigned PUT this API issues. Empty
# account/key => the client raises on the first upload; the rest of the app is
# unaffected, so image upload is the only thing that breaks.
# Dev and prod share the media bucket; the token below is scoped to it alone.
# The BACKUP bucket has a SEPARATE token that lives only in the server's
# secrets/backup.env — never put it here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=yupay-media
# Public read prefix, no trailing slash: the bucket's r2.dev URL, or a custom domain.
R2_PUBLIC_BASE_URL=

# ----- Guest-JWT email hashing -----
# Pepper for the SHA-256 email hashes embedded in guest JWTs. Generate one per
# environment — never reuse dev's in prod:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_EMAIL_PEPPER=yupay-dev-pepper-change-me

# ----- Observability -----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTLP_ENDPOINT=
LOG_LEVEL=INFO
LOG_JSON=false

# ----- CORS -----
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ----- Frontends -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yupay.io

# ----- Mini App dev HMR through ngrok / cloudflared -----
# When you tunnel the miniapp (3001) through a public HTTPS host, set
# MINIAPP_HMR_HOST so Vite's hot-reload websocket dials the tunnel instead
# of localhost:5173 (which the Telegram WebView can't reach). Leave blank
# when developing through plain `http://localhost:3001`.
# Example: MINIAPP_HMR_HOST=abc-123-45-67.ngrok-free.app
MINIAPP_HMR_HOST=
MINIAPP_HMR_PROTOCOL=wss
MINIAPP_HMR_CLIENT_PORT=443

# ----- Admin SPA dev HMR (same idea, separate hostname) -----
# Only set if you proxy the admin (3002) through a public HTTPS host.
ADMIN_HMR_HOST=
ADMIN_HMR_PROTOCOL=wss
ADMIN_HMR_CLIENT_PORT=443

# ----- Prod-only -----
# For production these values live in secrets/*.env inside the checkout on
# the VPS (see infra/secrets-example/README.md). Keep the dev placeholders
# below so a fresh `make dev` boots without env tweaks.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Production-specific reference (do NOT commit real values):
#   BASE_URL=https://api.yupay.uz
#   CORS_ALLOW_ORIGINS=["https://yupay.uz","https://app.yupay.uz","https://admin.yupay.uz"]
#   TELEGRAM_MINIAPP_URL=https://app.yupay.uz
#   NEXT_PUBLIC_API_BASE_URL=https://api.yupay.uz
#   NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yupay.uz

WAXPEER_API_KEY=

# G-Engine (api.g-engine.net) — second source for game top-ups.
# Empty disables the supplier. Never commit a real key.
GENGINE_API_KEY=

# NOVA (nova-gifts.com) — reserve for game top-ups, and the fallback for the
# player-id check when the primary could not answer. Empty disables both, which
# is the dev and CI default. NOVA_PLAYER_CHECK_ENABLED turns off just the check.
NOVA_API_KEY=
NOVA_PLAYER_CHECK_ENABLED=true

# ----- Blog import: Bunzy (ADR-0077) -----
# A third party writes one article a day; the scheduler pulls it in as a
# DRAFT and never publishes anything. Empty disables the job entirely, which
# is the dev and CI default.
#
# Server-side only. The key authenticates as our whole blog account, so it
# must never be given an NEXT_PUBLIC_ prefix or reach a browser bundle —
# nothing in apps/web or apps/miniapp reads it, and nothing should.
BUNZY_API_URL=https://app.bunzy.io
BUNZY_API_KEY=

# ----- Acquirer: Paynet (UWS + app deep link) -----
# Two halves: we build a deep link that opens the Paynet app with the order and
# amount pre-filled, and Paynet settles it by calling our JSON-RPC endpoint at
# /api/v1/payments/paynet/uws with these Basic credentials. Empty either half
# and the method disappears from checkout and the endpoint answers 401.
PAYNET_USERNAME=yupay_paynet
PAYNET_PASSWORD=
# Our service id in Paynet's registry — contractual, from Table 3 of the
# «Порядок технического взаимодействия» annex. A call carrying another one is
# refused with code 305.
PAYNET_SERVICE_ID=5878
# The deep link, as a FORMAT STRING. Paynet supplies the real host and
# parameter names after integration and published notes disagree on both, so
# correcting it is an env edit, not a release. Placeholders: {service_id},
# {account} (our order id), {amount} (tiyin), {amount_major} (so'm).
PAYNET_PAY_URL_TEMPLATE=https://paynet.uz/payment?provider_id={service_id}&amount={amount}&account={account}
