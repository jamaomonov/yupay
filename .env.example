# YuPay — root .env.example
# Copy to .env (gitignored) and fill in values for your local stack.

# ----- Postgres -----
POSTGRES_USER=yupay_app
POSTGRES_PASSWORD=yupay_app
POSTGRES_DB=yupay
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_PORT=6379

# ----- MinIO -----
MINIO_ROOT_USER=yupay
MINIO_ROOT_PASSWORD=yupay-dev-secret-change-me
MINIO_PORT_API=9000
MINIO_PORT_CONSOLE=9001

# ----- App -----
ENVIRONMENT=dev
DEBUG=true
SERVICE_NAME=yupay-api
BASE_URL=http://localhost:8000

# Set inside compose to point at service names. These are overrides for host processes.
DATABASE_URL=postgresql+asyncpg://yupay_app:yupay_app@postgres:5432/yupay
REDIS_URL=redis://redis:6379/0
DRAMATIQ_BROKER_URL=redis://redis:6379/1

# ----- Auth -----
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_ISSUER=yupay
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ----- Telegram -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ----- FX -----
# Free tier: https://www.exchangerate-api.com — 1500 req/mo.
# When empty, the chain falls through to exchangerate.host (often flaky).
FX_EXCHANGERATE_API_KEY=

# ----- Observability -----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTLP_ENDPOINT=
LOG_LEVEL=INFO
LOG_JSON=false

# ----- CORS -----
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ----- Frontends -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yupay.io

# ----- Mini App dev HMR through ngrok / cloudflared -----
# When you tunnel the miniapp (3001) through a public HTTPS host, set
# MINIAPP_HMR_HOST so Vite's hot-reload websocket dials the tunnel instead
# of localhost:5173 (which the Telegram WebView can't reach). Leave blank
# when developing through plain `http://localhost:3001`.
# Example: MINIAPP_HMR_HOST=abc-123-45-67.ngrok-free.app
MINIAPP_HMR_HOST=
MINIAPP_HMR_PROTOCOL=wss
MINIAPP_HMR_CLIENT_PORT=443

# ----- Prod-only (filled on the VPS, not in dev) -----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
