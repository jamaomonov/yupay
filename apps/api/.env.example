ENVIRONMENT=dev
DEBUG=true
SERVICE_NAME=yupay-api
BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://yupay_app:yupay_app@postgres:5432/yupay
REDIS_URL=redis://redis:6379/0
DRAMATIQ_BROKER_URL=redis://redis:6379/1

JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_ISSUER=yupay
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_EMAIL_TOKEN_TTL_SECONDS=1800
AUTH_IP_GUARD_MAX=10
AUTH_IP_GUARD_WINDOW_SECONDS=60
WEB_BASE_URL=

# Email (Resend) — verify/reset + guest order emails. Empty key => sends skipped.
RESEND_API_KEY=
EMAIL_FROM=noreply@yupay.uz
EMAIL_FROM_NAME=YuPay

TELEGRAM_BOT_TOKEN=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTLP_ENDPOINT=
LOG_LEVEL=INFO
LOG_JSON=false

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:3001"]
