VITE_API_BASE_URL=http://localhost:8000
VITE_TELEGRAM_BOT_USERNAME=
# Customer-support contact (Telegram username, no @). Falls back to the bot's
# deep-link if empty, but it's much better UX to have a dedicated support user.
VITE_TELEGRAM_SUPPORT_USERNAME=

# Legal documents are not configured here. Settings links out to the
# published set on the storefront (see src/lib/legal.ts) — one copy of
# the offer, one place to correct it.

# Operating entity displayed in the About sheet. CIS customers scan
# for these — leave empty until the legal entity is registered.
VITE_COMPANY_NAME=
VITE_COMPANY_REGISTRATION=
VITE_COMPANY_SINCE=
